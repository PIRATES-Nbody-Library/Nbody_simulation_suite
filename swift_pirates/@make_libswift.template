#!/bin/sh

# @make_libswift template — used internally by setup.sh to generate @make_libswift

SWIFT_DIR="__SWIFT_DIR__"
FORTRAN="__FORTRAN__"
FFLAGS="__FFLAGS__"
PRECOMP="__PRECOMP__"
CPPFLAGS="__CPPFLAGS__"

if ls *.F >/dev/null 2>&1; then
  echo "Doing precompiler"
  for file in *.F; do
    file2=$(echo "$file" | awk -F"." '{print$1}')
    echo "$file2"
    $PRECOMP $CPPFLAGS "${file2}.F" "${file2}_CPP.f"
  done
else
  echo "No need to precompile"
fi

echo "Doing Fortran"
for file in *.f; do
  file2=$(echo "$file" | awk -F"." '{print$1}')
  echo "$file2"
  $FORTRAN $FFLAGS "${file2}.f"
  ar vr "$SWIFT_DIR/libswift.a" "${file2}.o"
done

rm -f *.o
rm -f *CPP.f
echo "Done directory $PWD"
echo
